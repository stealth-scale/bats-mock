root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 2
indent_style = space
insert_final_newline = true
max_line_length = 100
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.{bash,bats,sh}]
indent_size = 4

[{Makefile,scripts/*}]
indent_size = 4

[Makefile]
indent_style = tab
